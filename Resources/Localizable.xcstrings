    "秘钥引用无效。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The key reference is invalid."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密钥引用无效。"}}}},
    "无法访问本地加密秘钥存储。": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The encrypted key store is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法访问本机加密密钥存储。"}}}},
